{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cobria.dev/schema/engineering-adoption-1.0.0.json",
  "title":"Manifiesto de adopción COBRIA Engineering",
  "type":"object",
  "required":["schemaVersion","project","scope","contracts","limits"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},
    "project":{"type":"object","required":["repository","ref"],"properties":{"repository":{"type":"string","format":"uri"},"ref":{"type":"string","minLength":1},"expectedRemote":{"type":"string","format":"uri"},"expectedCommit":{"type":"string","pattern":"^[0-9a-f]{40}$"}},"additionalProperties":false},
    "scope":{"type":"string","minLength":1},
    "contracts":{"type":"array","minItems":8,"maxItems":8,"items":{"type":"object","required":["id","name","owner","evidence"],"properties":{"id":{"pattern":"^ENG-00[1-8]$"},"name":{"type":"string","minLength":1},"owner":{"type":"string","minLength":1},"evidence":{"type":"array","minItems":1,"items":{"type":"object","required":["path","containsAll"],"properties":{"path":{"type":"string","minLength":1},"containsAll":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}},"additionalProperties":false}}},"additionalProperties":false}},
    "limits":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
  },
  "additionalProperties":false
}
