{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cobria.example.invalid/schemas/manifest.schema.json",
  "title":"Manifiesto COBRIA","type":"object","additionalProperties":false,
  "required":["schemaVersion","manifestId","generatedFrom","records"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},"manifestId":{"type":"string","pattern":"^cobria-[a-z-]+$"},
    "generatedFrom":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "records":{"type":"array","items":{"$ref":"#/$defs/record"}}
  },
  "$defs":{"record":{"type":"object","additionalProperties":false,"required":["id","source","version","owner","references","data"],"properties":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},"source":{"type":"string","minLength":1},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"owner":{"type":"string","minLength":1},"references":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"data":{"type":"object"}}}}
}
