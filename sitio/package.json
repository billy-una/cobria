{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-vinext-pc8.mjs",
    "test:stream": "node scripts/patch-vinext-pc8.mjs --check && node --test tests/stream-pc8.test.mjs",
    "predev": "node ../editorial/build-curriculum.mjs && node scripts/generate-search-pages.mjs",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "node ../editorial/build-curriculum.mjs && node scripts/generate-search-pages.mjs && node scripts/sync-downloads.mjs",
    "build": "COBRIA_DETERMINISTIC_BUILD=1 NODE_OPTIONS=--require=./scripts/deterministic-build.cjs WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "postbuild": "node scripts/normalize-build-maps.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --test tests/glob-compat.test.mjs tests/build-maps.test.mjs && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "fast-glob": "file:vendor/fast-glob-0.0.0-cobria.1.tgz",
    "@cloudflare/vite-plugin": "1.66.0",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.10",
    "vite": "8.3.5",
    "wrangler": "4.155.0"
  },
  "overrides": {
    "fast-glob": "$fast-glob",
    "satori": "0.33.5",
    "fast-uri": "3.1.9",
    "fflate": "0.7.5"
  },
  "type": "module"
}
